<?xml version='1.0' encoding='utf-8'?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration">

<hibernate-configuration>
    <session-factory>
        <property name="hibernate.connection.driver_class">org.h2.Driver</property>
        <property name="hibernate.connection.url">jdbc:h2:tcp://localhost:4242/file:./data/h2/fixMeDb</property>
        <property name="hibernate.connection.username">sa</property>
        <property name="hibernate.connection.password"></property>
        <property name="show_sql">false</property>
        <property name="hbm2ddl.auto">update</property>

        <!-- Entities -->
        <mapping class="com.nguyen.market.model.Instrument"/>
        <mapping class="com.nguyen.market.model.FirstFlag"/>
        <mapping class="com.nguyen.market.model.FixTransaction"/>

    </session-factory>
</hibernate-configuration>
